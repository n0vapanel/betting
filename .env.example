# Copy to .env and fill in. .env is gitignored: never commit real keys.
TELEGRAM_BOT_TOKEN=
# Chat that brain/notify.py posts updates to (your Telegram user ID or a channel ID)
TELEGRAM_CHANNEL_ID=
# Needed for real predictions; without them the bot replies "No predictions available"
API_SPORTS_KEY=
THE_ODDS_API_KEY=
# Optional: adjusts predictions for injury news
NEWS_API_KEY=
