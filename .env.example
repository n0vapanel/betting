# Copy to .env and fill in. .env is gitignored: never commit real keys.
TELEGRAM_BOT_TOKEN=
# Chat that brain/notify.py posts updates to (your Telegram user ID or a channel ID)
TELEGRAM_CHANNEL_ID=
# Upcoming games and odds shown by the bot (free key at the-odds-api.com)
THE_ODDS_API_KEY=
# Timezone for game start times (IANA name); defaults to America/New_York
TIMEZONE=America/New_York
# Optional: used by the prediction engine and backtests, not by the bot menu
API_SPORTS_KEY=
NEWS_API_KEY=
